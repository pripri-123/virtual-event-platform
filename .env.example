# Flask core
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Database — local SQLite (development)
DATABASE_URL=sqlite:///instance/vehp.db

# Azure SQL Database (production) — set these instead of DATABASE_URL
# Requires: pip install -r requirements-azure.txt + ODBC Driver 18
# AZURE_SQL_SERVER=your-server
# AZURE_SQL_DATABASE=vehp-db
# AZURE_SQL_USERNAME=vehpadmin
# AZURE_SQL_PASSWORD=your-strong-password

# Or use a full connection string:
# DATABASE_URL=mssql+pyodbc://user:pass@server.database.windows.net:1433/vehp-db?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Azure Blob Storage (Phase 11)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=vehp-uploads

# Azure Functions (Phase 13)
FUNCTION_APP_URL=
FUNCTION_APP_KEY=

# Application Insights (Phase 14)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Email (Phase 13 — Azure Functions or SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@yourdomain.com
